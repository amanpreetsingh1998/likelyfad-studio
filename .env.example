# Google Gemini API Key (Required for image generation and Google LLM)
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional - only needed if using OpenAI LLM provider)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional - only needed if using Anthropic Claude LLM provider)
# Get your API key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Replicate API Key (Optional - only needed if using Replicate models)
# Get your API key from: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your_replicate_api_key_here

# fal.ai API Key (Optional - only needed if using fal.ai models)
# Get your API key from: https://fal.ai/dashboard/keys
FAL_API_KEY=your_fal_api_key_here

# Kie.ai API Key (Optional - only needed if using Kie.ai models like Sora, Veo, Kling)
# Get your API key from: https://kie.ai/
KIE_API_KEY=your_kie_api_key_here

# WaveSpeed API Key (Optional - only needed if using WaveSpeed models)
# Get your API key from: https://wavespeed.ai/
WAVESPEED_API_KEY=your_wavespeed_api_key_here

# ─── Supabase (cloud persistence) ────────────────────────────────────────
# All three come from: Supabase dashboard -> Project Settings -> API
# Run `npm run supabase:check` after filling these in to verify the connection.
# Schema + storage bucket setup lives in supabase/schema.sql

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / publishable key. Safe to expose to the browser - it is bound by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service role key. Bypasses RLS - server-side only, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Razorpay (credit purchases) ─────────────────────────────────────────
# Dashboard -> Settings -> API Keys. The key id is public; the secret is not.

# Public: the browser checkout needs it.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Server only.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Server only. Set this when adding the payment.captured webhook, and use the
# same value in Dashboard -> Settings -> Webhooks.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ─── Scheduled maintenance ───────────────────────────────────────────────
# Shared secret for POST /api/cron/maintenance, which settles abandoned
# workflow charges and applies retention to generation_events.
#
# There is no user session behind that route, so this secret is the only thing
# guarding it. Generate a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Leaving it unset does not open the route - the route refuses every request
# while it is missing.
CRON_SECRET=your_long_random_cron_secret_here

# ─── Local filesystem routes ─────────────────────────────────────────────
# Opt-in. Set to 1 ONLY when running Likelyfad Studio as a local desktop tool
# against a directory on this machine.
#
# In a hosted deployment leave it unset. These routes read, write and enumerate
# the host's filesystem on behalf of the browser, which is a feature on
# localhost and remote filesystem access anywhere else. The cloud persistence
# path (/api/likelyfad/*) covers the same ground with a session in front of it,
# so a hosted deployment loses nothing by leaving these off.
ENABLE_LOCAL_FILESYSTEM_ROUTES=
